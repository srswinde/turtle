*.pyc
*.zip
*.gif
*.jpg
*.jpeg
*.png
*.mp4
*.log
nohup.out
model.pth
*.sql
*.csv
*.json
# Keep the vendored ML dependency needed by Dockerfile.ml:
!swahle/vendor/
