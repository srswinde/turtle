# Copy to .env and adjust. All vars are prefixed SWAHLE_.

# --- Database (keep MariaDB — the existing datadir) ---
SWAHLE_DATABASE_URI=mysql+pymysql://scott:scott@localhost/turtle

# --- Image storage (RAID mounts; preserve date-based layout) ---
SWAHLE_HOLE_CAM_DIR=/mnt/nfs/hole-cam
SWAHLE_TURTLE_IMG_DIR=/mnt/turtle/imgs
SWAHLE_LIVE_IMG_ROOT=/mnt/turtle

# --- Live feed (Redis pub/sub from the ingest side) ---
SWAHLE_REDIS_HOST=localhost
SWAHLE_REDIS_PORT=6379

# --- Auth (Cloudflare Access) ---
# Leave blank in dev; with dev_bypass_auth on, /app/* is reachable without CF.
SWAHLE_CF_ACCESS_TEAM_DOMAIN=
SWAHLE_CF_ACCESS_AUD=
SWAHLE_DEV_BYPASS_AUTH=true

# =====================================================================
# Docker Compose deployment (docker-compose.yml). Not used in local dev.
# =====================================================================

# --- Database (MariaDB service; reuses the existing ../data datadir) ---
DB_ROOT_PASSWORD=change-me-root-password
DB_USER=scott
DB_PASSWORD=scott
DB_NAME=turtle

# --- Cloudflare Access (fill from your Access application) ---
CF_ACCESS_TEAM_DOMAIN=          # e.g. swahle.cloudflareaccess.com
CF_ACCESS_AUD=                  # Access application AUD tag

# --- Cloudflare Tunnel ---
# Also replace <TUNNEL_ID> in cloudflared/config.yml and drop the tunnel
# credentials JSON in cloudflared/.
TUNNEL_ID=
