[Unit]
Description=Swahle services control agent
After=network-online.target
Wants=network-online.target

[Service]
User=scott
WorkingDirectory=/home/scott/git-clones/turtle_db
Environment=PYTHONPATH=/home/scott/git-clones/turtle_db/swahle:/home/scott/git-clones/turtle_db
ExecStart=/home/scott/anaconda3/bin/python -m uvicorn modules.services.agent:app --host 0.0.0.0 --port 9300
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
